# Secrets referenced as ${VAR} from the MCP registry and injected by the drivers.
# Copy to ~/.config/agents/keys.env, fill in, chmod 600. NEVER commit the real file.

# Per-agent Mesh key (or set per-agent in fiddler.json / mesh-agents.json instead).
MESH_AGENT_KEY=agk_REPLACE_WITH_YOUR_AGENT_KEY

# Example third-party MCP secrets (only if you enable those servers in the registry):
# POSTHOG_API_KEY=phx_...
# GOOGLE_APPLICATION_CREDENTIALS=/Users/fleet/.config/secrets/ga-service-account.json
